<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonicalize accidentally exposed Laravel public URLs.
    RewriteCond %{THE_REQUEST} \s/+(.*/)?public([/?\s]) [NC]
    RewriteRule ^public/?$ ./ [L,R=301,NE]

    RewriteCond %{THE_REQUEST} \s/+(.*/)?public/ [NC]
    RewriteRule ^public/(.*)$ $1 [L,R=301,NE]

    # Route project-root requests into Laravel's public front controller.
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>
